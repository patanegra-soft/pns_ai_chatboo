<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pns_ai_chatboo.ChatbooApp">
        <div class="o_content o_chatboo_container o_chatboo_app d-flex flex-column h-100 position-relative"
             t-ref="this.rootRef"
             t-on-dragenter="(ev) => this._onDragOver(ev)"
             t-on-dragover="(ev) => this._onDragOver(ev)"
             t-on-dragleave="(ev) => this._onDragLeave(ev)"
             t-on-drop="(ev) => this._onDrop(ev)">

            <!-- Overlay al arrastrar ficheros sobre CUALQUIER zona del chat. Es
                 solo visual (pointer-events:none): el 'drop' llega a la raíz. -->
            <div t-if="this.state.dragActive"
                 style="position:absolute;inset:0;z-index:2000;pointer-events:none;background:rgba(13,110,253,0.08);border:2px dashed #0d6efd;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                <div style="background:#fff;padding:14px 22px;border-radius:8px;box-shadow:0 2px 12px rgba(0,0,0,0.15);color:#0d6efd;font-weight:600;display:flex;flex-direction:column;align-items:center;gap:6px;">
                    <i class="fa fa-cloud-upload fa-2x"/>
                    <span t-out="this.dropHint"/>
                </div>
            </div>

            <!-- Cabecera O14: enchufe + proveedor, sin logo redundante -->
            <div class="o_chatboo_main_header px-3 py-2 border-bottom d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width:0;">
                    <div class="o_chatboo_status text-muted opacity-75" style="white-space:nowrap;">
                        <t t-if="this.state.providerModel">
                            <i t-attf-class="fa fa-plug me-1 {{ this.state.connected ? 'text-success' : 'text-danger' }}"
                               style="cursor:pointer;" t-att-title="this.tipTestConnection"
                               t-on-click="() => this._testConnection()"/>
                            <span class="o_chatboo_provider_pick"
                                  t-attf-class="o_chatboo_provider_pick {{ this.state.providers.length > 1 ? 'o_chatboo_provider_clickable' : '' }}"
                                  t-att-title="this.state.providers.length > 1 ? this.tipChangeProvider : undefined"
                                  t-on-click="() => this._toggleProviderMenu()">
                                <span t-if="this.state.providerHost" class="fw-normal opacity-75"><t t-out="this.state.providerHost"/> → </span>
                                <strong t-out="this.state.providerModel"/>
                                <i t-if="this.state.providers.length > 1" class="fa fa-caret-down ms-1 opacity-50"/>
                                <t t-if="this.state.providerMenuOpen">
                                    <div class="o_chatboo_provider_backdrop" t-on-click.stop="() => this._closeProviderMenu()"/>
                                    <ul class="o_chatboo_provider_menu" t-on-click.stop="() => {}">
                                        <t t-foreach="this.state.providers" t-as="prov" t-key="prov.id">
                                            <li t-attf-class="o_chatboo_provider_item {{ prov.id === this.state.selectedProviderId ? 'active' : '' }}"
                                                t-on-click.stop="() => this._selectProvider(prov.id)">
                                                <t t-out="prov.display || prov.name"/>
                                            </li>
                                        </t>
                                    </ul>
                                </t>
                            </span>
                        </t>
                        <t t-elif="this.state.providerName">
                            <i t-attf-class="fa fa-plug me-1 {{ this.state.connected ? 'text-success' : 'text-danger' }}"
                               style="cursor:pointer;" t-att-title="this.tipTestConnection"
                               t-on-click="() => this._testConnection()"/>
                            <t t-out="this.state.providerName"/>
                        </t>
                        <t t-else=""><t t-out="this.tipConnecting"/></t>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-secondary" t-on-click="() => this._createNewSession(true)" t-att-title="this.tipNewChat">
                        <i class="fa fa-plus"/> <t t-out="this.tipNew"/>
                    </button>
                    <button class="btn btn-sm btn-secondary" t-on-click="() => this._showSessions()" t-att-title="this.tipHistory">
                        <i class="fa fa-history"/> <t t-out="this.tipHistory"/>
                    </button>
                </div>
            </div>

            <!-- Mensajes -->
            <div class="o_chatboo_messages flex-grow-1 p-3" t-ref="this.messagesRef" style="overflow-y:auto;min-height:0;">

                <t t-if="!this.state.messages.length &amp;&amp; !this.state.thinking">
                    <div class="text-center text-muted mt-5">
                        <p>How can I help you today?</p>
                    </div>
                </t>

                <t t-foreach="this.state.messages" t-as="msg" t-key="msg_index">
                    <div t-if="!msg.result_note" t-attf-class="d-flex mb-2 {{ msg.role === 'user' ? 'justify-content-end' : 'justify-content-start' }}{{ msg.wideCanvas ? ' o_chatboo_message_row--chart' : '' }}"
                         t-att-data-msg-index="msg_index"
                         t-att-data-turn="msg.contextInfo and msg.contextInfo.turn">
                        <div t-attf-class="o_chatboo_message o_chatboo_bubble card border-0 shadow-sm p-2 {{ msg.role === 'user' ? 'bg-primary text-white o_chatboo_user' : 'bg-white o_chatboo_assistant' }}{{ msg.wideCanvas ? ' o_chatboo_message--chart' : '' }}"
                             t-att-data-ai-generated="msg.role === 'assistant' ? 'true' : undefined"
                             style="position:relative;">
                            <div t-if="msg.wideCanvas"
                                 class="o_chatboo_card_resize"
                                 t-on-pointerdown="this._onCardResizeStart"/>
                            <t t-if="msg.role === 'assistant'">
                                <div t-attf-class="d-flex mb-1 gap-1 o_ai_export_bar {{ msg.wideCanvas ? 'justify-content-between' : 'justify-content-end' }}">
                                    <i t-if="msg.wideCanvas"
                                       class="fa fa-compress o_ai_copy_btn text-muted o_chatboo_card_width_reset"
                                       t-att-title="this.tipRestoreCardWidth"
                                       t-on-click="this._resetCardWidth"/>
                                    <span class="d-flex gap-1">
                                    <i class="fa fa-file-pdf-o o_ai_copy_btn text-danger"
                                       t-att-title="this.tipDownloadPdf"
                                       t-att-data-msg-index="msg_index"
                                       t-on-click="this._downloadAsPDF"/>
                                    <i class="fa fa-file-excel-o o_ai_copy_btn text-success"
                                       t-att-title="this.tipDownloadExcel"
                                       t-att-data-msg-index="msg_index"
                                       t-on-click="this._downloadAsExcel"/>
                                    <i class="fa fa-file-word-o o_ai_copy_btn text-primary"
                                       t-att-title="this.tipDownloadWord"
                                       t-att-data-msg-index="msg_index"
                                       t-on-click="this._downloadAsWord"/>
                                    <i class="fa fa-copy o_ai_copy_btn text-muted"
                                       t-att-title="this.tipCopyContent"
                                       t-att-data-msg-index="msg_index"
                                       data-copy-type="content"
                                       t-on-click="this._copyToClipboard"/>
                                    <span class="o_chatboo_md_col">
                                    <i class="fa fa-code o_ai_copy_btn text-muted"
                                       t-att-title="this.tipCopyMarkdown"
                                       t-att-data-msg-index="msg_index"
                                       data-copy-type="markdown"
                                       t-on-click="this._copyToClipboard"/>
                                    <i class="fa fa-chevron-down o_ai_copy_btn text-muted o_chatboo_turn_jump"
                                       t-att-title="this.tipGoToEnd"
                                       data-edge="end"
                                       t-on-click="this._scrollTurnEdge"/>
                                    </span>
                                    </span>
                                </div>
                                <div t-if="msg.files and msg.files.length" class="o_chatboo_file_banner_list">
                                    <t t-foreach="msg.files" t-as="mfile" t-key="mfile_index">
                                        <a t-if="mfile.url" t-att-href="this._fileDownloadHref(mfile)"
                                           t-att-download="this._fileDownloadName(mfile)"
                                           t-att-class="this._fileBannerCardClass(mfile)"
                                           t-att-type="this._fileLinkType(mfile)"
                                           t-att-title="mfile.name">
                                            <span class="o_chatboo_file_banner_preview" aria-hidden="true">
                                                <i t-att-class="'fa ' + this._fileIcon(mfile)"/>
                                            </span>
                                            <span class="o_chatboo_file_banner_meta">
                                                <span class="o_chatboo_file_banner_title" t-out="mfile.name"/>
                                                <span t-if="this._fileSizeLabel(mfile)" class="o_chatboo_file_banner_size"
                                                      t-out="this._fileSizeLabel(mfile)"/>
                                                <span class="o_chatboo_file_banner_cta" t-out="this.tipDownloadFile"/>
                                            </span>
                                        </a>
                                        <span t-else=""
                                              t-att-class="this._fileBannerCardClass(mfile)"
                                              t-att-title="mfile.name"
                                              t-att-data-msg-index="msg_index"
                                              t-att-data-file-index="mfile_index"
                                              t-att-style="mfile.pending ? 'cursor:pointer' : false"
                                              t-on-click="this._fulfillChipClick">
                                            <span class="o_chatboo_file_banner_preview" aria-hidden="true">
                                                <i t-att-class="'fa ' + this._fileIcon(mfile)"/>
                                            </span>
                                            <span class="o_chatboo_file_banner_meta">
                                                <span class="o_chatboo_file_banner_title" t-out="mfile.name"/>
                                                <span t-if="this._fileSizeLabel(mfile)" class="o_chatboo_file_banner_size"
                                                      t-out="this._fileSizeLabel(mfile)"/>
                                                <span t-if="mfile.pending" class="o_chatboo_file_banner_cta" t-out="this.tipPrepareFile"/>
                                            </span>
                                        </span>
                                    </t>
                                </div>
                            </t>
                            <t t-if="msg.role === 'user'">
                                <div class="d-flex justify-content-end mb-1">
                                    <i class="fa fa-copy o_ai_copy_btn"
                                       t-att-title="this.tipCopyClipboard"
                                       t-att-data-msg-index="msg_index"
                                       data-copy-type="content"
                                       t-on-click="this._copyToClipboard"/>
                                </div>
                            </t>
                            <t t-if="msg.role === 'user'">
                                <div t-if="msg.images and msg.images.length" class="mb-1 d-flex flex-wrap gap-1">
                                    <t t-foreach="msg.images" t-as="mimg" t-key="mimg_index">
                                        <span class="d-inline-flex flex-column align-items-start">
                                            <a t-att-href="mimg.url or mimg" target="_blank" rel="noopener"
                                               t-att-title="mimg.name or this.tipOpenImage">
                                                <img t-att-src="mimg.url or mimg" t-att-alt="mimg.name or 'image'"
                                                     style="max-width:100%;max-height:220px;border-radius:6px;cursor:zoom-in;"/>
                                            </a>
                                            <span t-if="mimg.name" class="text-truncate text-muted"
                                                  style="font-size:0.72em;max-width:220px;" t-out="mimg.name"/>
                                        </span>
                                    </t>
                                </div>
                                <div t-if="msg.files and msg.files.length" class="o_chatboo_file_banner_list">
                                    <t t-foreach="msg.files" t-as="mfile" t-key="mfile_index">
                                        <a t-if="mfile.url" t-att-href="this._fileDownloadHref(mfile)"
                                           t-att-download="this._fileDownloadName(mfile)"
                                           t-att-class="this._fileBannerCardClass(mfile)"
                                           t-att-type="this._fileLinkType(mfile)"
                                           t-att-title="mfile.name">
                                            <span class="o_chatboo_file_banner_preview" aria-hidden="true">
                                                <i t-att-class="'fa ' + this._fileIcon(mfile)"/>
                                            </span>
                                            <span class="o_chatboo_file_banner_meta">
                                                <span class="o_chatboo_file_banner_title" t-out="mfile.name"/>
                                                <span t-if="this._fileSizeLabel(mfile)" class="o_chatboo_file_banner_size"
                                                      t-out="this._fileSizeLabel(mfile)"/>
                                                <span class="o_chatboo_file_banner_cta" t-out="this.tipDownloadFile"/>
                                            </span>
                                        </a>
                                        <span t-else=""
                                              t-att-class="this._fileBannerCardClass(mfile)"
                                              t-att-title="mfile.name"
                                              t-att-data-msg-index="msg_index"
                                              t-att-data-file-index="mfile_index"
                                              t-att-style="mfile.pending ? 'cursor:pointer' : false"
                                              t-on-click="this._fulfillChipClick">
                                            <span class="o_chatboo_file_banner_preview" aria-hidden="true">
                                                <i t-att-class="'fa ' + this._fileIcon(mfile)"/>
                                            </span>
                                            <span class="o_chatboo_file_banner_meta">
                                                <span class="o_chatboo_file_banner_title" t-out="mfile.name"/>
                                                <span t-if="this._fileSizeLabel(mfile)" class="o_chatboo_file_banner_size"
                                                      t-out="this._fileSizeLabel(mfile)"/>
                                                <span t-if="mfile.pending" class="o_chatboo_file_banner_cta" t-out="this.tipPrepareFile"/>
                                            </span>
                                        </span>
                                    </t>
                                </div>
                                <div t-if="msg.raw" class="o_chatboo_content" t-out="msg.raw"/>
                            </t>
                            <t t-elif="msg.htmlSrc">
                                <ChatbooHtmlRenderer html="msg.htmlSrc"/>
                            </t>
                            <t t-else="">
                                <div class="o_chatboo_content" t-out="msg.content"/>
                            </t>
                            <div class="o_chatboo_ts_row">
                                <div t-attf-class="o_ai_ts {{ msg.role === 'user' ? 'text-white' : '' }}" t-out="msg.ts"/>
                                <div t-if="msg.role === 'assistant'" class="d-flex gap-1 o_ai_export_bar">
                                    <i class="fa fa-file-pdf-o o_ai_copy_btn text-danger"
                                       t-att-title="this.tipDownloadPdf"
                                       t-att-data-msg-index="msg_index"
                                       t-on-click="this._downloadAsPDF"/>
                                    <i class="fa fa-file-excel-o o_ai_copy_btn text-success"
                                       t-att-title="this.tipDownloadExcel"
                                       t-att-data-msg-index="msg_index"
                                       t-on-click="this._downloadAsExcel"/>
                                    <i class="fa fa-file-word-o o_ai_copy_btn text-primary"
                                       t-att-title="this.tipDownloadWord"
                                       t-att-data-msg-index="msg_index"
                                       t-on-click="this._downloadAsWord"/>
                                    <i class="fa fa-copy o_ai_copy_btn text-muted"
                                       t-att-title="this.tipCopyContent"
                                       t-att-data-msg-index="msg_index"
                                       data-copy-type="content"
                                       t-on-click="this._copyToClipboard"/>
                                    <span class="o_chatboo_md_col">
                                    <i class="fa fa-code o_ai_copy_btn text-muted"
                                       t-att-title="this.tipCopyMarkdown"
                                       t-att-data-msg-index="msg_index"
                                       data-copy-type="markdown"
                                       t-on-click="this._copyToClipboard"/>
                                    <i class="fa fa-chevron-up o_ai_copy_btn text-muted o_chatboo_turn_jump"
                                       t-att-title="this.tipGoToStart"
                                       data-edge="start"
                                       t-on-click="this._scrollTurnEdge"/>
                                    </span>
                                </div>
                            </div>
                            <t t-if="msg.meta and msg.meta.model">
                                <div class="text-muted" style="font-size:0.85em;">
                                    <i class="fa fa-microchip me-1"/>
                                    <t t-out="msg.meta.model"/>
                                    <t t-if="msg.meta.provider"> · <t t-out="msg.meta.provider"/></t>
                                </div>
                            </t>
                            <t t-if="msg.meta and msg.meta.sources and msg.meta.sources.length">
                                <div class="text-muted" style="font-size:0.85em;">
                                    <i class="fa fa-link me-1"/>
                                    <t t-out="this.tipSource"/> <t t-out="msg.meta.sources.join(', ')"/>
                                </div>
                            </t>
                            <t t-if="msg.meta and msg.meta.records and msg.meta.records.length">
                                <div class="o_chatboo_ack_records">
                                    <t t-foreach="msg.meta.records" t-as="mrec" t-key="mrec_index">
                                        <a t-if="mrec.role === 'document'"
                                           t-att-href="this._recordUrl(mrec)" target="_blank" rel="noopener"
                                           class="o_chatboo_ack_doc_card"
                                           t-att-title="mrec.model + ' #' + mrec.id">
                                            <span class="o_chatboo_ack_doc_icon">
                                                <i class="fa fa-file-text-o"/>
                                            </span>
                                            <span class="o_chatboo_ack_doc_body">
                                                <span class="o_chatboo_ack_doc_name" t-out="mrec.name"/>
                                                <span class="o_chatboo_ack_doc_meta" t-out="mrec.model + ' #' + mrec.id"/>
                                            </span>
                                            <i class="fa fa-external-link o_chatboo_ack_doc_open"/>
                                        </a>
                                    </t>
                                </div>
                            </t>
                            <t t-if="msg.contextInfo">
                                <div class="o_chatboo_context_info d-flex justify-content-between align-items-center mt-1"
                                     t-attf-style="cursor:pointer;"
                                     t-on-click="() => this._showContextStats()">
                                    <span class="o_chatboo_usage_chips">
                                        <span t-if="msg.contextInfo.turn" class="o_chatboo_usage_chip o_chatboo_usage_chip--turn"
                                              t-att-title="msg.contextInfo.turnTitle"
                                              t-att-data-turn="msg.contextInfo.turn"
                                              t-on-click.stop="(ev) => this._copyTurn(ev, msg.contextInfo.turn)">
                                            <t t-out="msg.contextInfo.turn"/>
                                        </span>
                                        <span t-if="msg.contextInfo.showBuffer"
                                              t-attf-class="o_chatboo_usage_chip o_chatboo_usage_chip--buffer o_chatboo_usage_chip--buffer-{{ msg.contextInfo.bufferLevel }}"
                                              t-att-title="msg.contextInfo.bufferTitle">
                                            <i t-attf-class="fa {{ msg.contextInfo.icon }} me-1"/>
                                            <t t-out="msg.contextInfo.usedK"/>k / <t t-out="msg.contextInfo.limitK"/>k (<t t-out="msg.contextInfo.usagePercent"/>%)
                                        </span>
                                        <span class="o_chatboo_usage_chip o_chatboo_usage_chip--spend"
                                              t-att-title="msg.contextInfo.spendTitle">
                                            <t t-out="msg.contextInfo.spendLabel"/>
                                        </span>
                                    </span>
                                    <span t-if="msg.contextInfo.speedTps" t-att-title="msg.contextInfo.speedTitle">
                                        <i class="fa fa-bolt me-1"/>
                                        <t t-out="msg.contextInfo.speedTps"/> tok/s
                                    </span>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <t t-if="this.state.thinking">
                    <div class="d-flex justify-content-start mb-3">
                        <div class="o_chatboo_bubble o_chatboo_assistant card border-0 shadow-sm p-3 bg-white">
                            <div class="d-inline-flex align-items-center flex-wrap" style="gap:10px;">
                                <span class="o_chatboo_typing"><span/><span/><span/></span>
                                <span class="text-muted"><t t-out="this.state.statusLabel || this.tipThinking"/></span>
                                <button t-if="this.state.canCancel" class="btn btn-sm btn-link text-muted p-0 ms-1"
                                        type="button"
                                        t-on-click="() => this._cancelStream()"
                                        style="text-decoration:none;" t-att-title="this.tipCancel">
                                    <i class="fa fa-stop-circle-o"/> <t t-out="this.tipCancel"/>
                                </button>
                            </div>
                            <t t-if="this.state.streamingHtml">
                                <div class="mt-2">
                                    <ChatbooHtmlRenderer html="this.state.streamingHtml"/>
                                </div>
                            </t>
                            <t t-elif="this.state.streamingPreview">
                                <div class="o_chatboo_content mt-2" t-out="this.state.streamingPreview"/>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Entrada (estilo O14) -->
            <div class="o_chatboo_main_footer border-top px-3 py-2">
                <div class="o_chatboo_footer_prefs mb-2">
                    <span t-if="this.state.screenFocusLabel"
                          t-attf-class="o_chatboo_directive_chip badge rounded-pill {{ this.state.screenFocusEnabled ? 'bg-primary-subtle text-primary border border-primary-subtle' : 'o_chatboo_directive_chip--off' }}"
                          style="font-weight:500;font-size:0.78em;cursor:pointer;"
                          t-on-click="() => this.toggleScreenFocus()"
                          t-att-data-tip="this.screenFocusTitle"
                          t-att-aria-label="this.screenFocusTitle">
                        <i class="fa fa-crosshairs me-1"/>
                        <t t-out="this.state.screenFocusLabel"/>
                    </span>
                    <span t-attf-class="o_chatboo_show_series_stats o_chatboo_directive_chip badge rounded-pill {{ this.state.showSeriesStats ? 'bg-primary-subtle text-primary border border-primary-subtle' : 'o_chatboo_directive_chip--off' }}"
                          style="font-weight:500;font-size:0.78em;cursor:pointer;"
                          t-on-click="() => this._toggleShowSeriesStats()"
                          t-att-data-tip="this.seriesStatsTitle"
                          t-att-aria-label="this.seriesStatsTitle">
                        <i class="fa fa-bar-chart me-1"/>
                        stats
                    </span>
                </div>
                <div class="d-flex align-items-start gap-3">
                    <button t-if="this.state.ttsSupported"
                            type="button"
                            t-attf-class="btn btn-light border o_chatboo_tts_toggle {{ this.state.ttsEnabled ? 'o_chatboo_tts_on' : '' }}"
                            t-att-aria-label="this.ttsTitle"
                            t-on-click="() => this._toggleTts()"
                            t-att-disabled="this.state.thinking"
                            style="border-radius: 8px;">
                        <img t-att-src="this.state.ttsEnabled ? '/pns_ai_chatboo/static/src/img/chatboo_tts_volume_on.svg' : '/pns_ai_chatboo/static/src/img/chatboo_tts_volume_off.svg'"
                             alt="" width="22" height="22"/>
                    </button>
                    <div class="position-relative flex-grow-1">
                        <div t-if="this.state.slashOpen" class="o_chatboo_slash dropdown-menu show p-1"
                             t-ref="this.slashMenuRef"
                             style="position:absolute;bottom:100%;left:0;right:0;margin-bottom:4px;">
                            <t t-foreach="this.state.slashItems" t-as="sk" t-key="sk.code">
                                <button type="button"
                                        t-attf-class="dropdown-item rounded {{ sk_index === this.state.slashIndex ? 'active' : '' }}"
                                        t-on-mousedown.prevent="() => this._applySlashSelection(sk)">
                                    <span class="fw-bold">/<t t-out="sk.code"/></span>
                                    <span t-if="sk.kind === 'builtin'" class="badge bg-secondary ms-2" style="font-size:.7em;">command</span>
                                    <span t-if="sk.kind === 'skill' &amp;&amp; sk.badgeLabel"
                                          t-attf-class="badge ms-2 {{ sk.mine ? 'bg-info o_chatboo_skill_mine' : 'bg-secondary' }}"
                                          style="font-size:.7em;" t-out="sk.badgeLabel"/>
                                    <small t-attf-class="ms-2 o_chatboo_slash_desc {{ sk_index === this.state.slashIndex ? '' : 'text-muted' }}"
                                           t-out="sk.description"/>
                                </button>
                            </t>
                        </div>
                        <div t-if="this.state.pendingImages.length" class="d-flex flex-wrap gap-1 mb-1">
                            <t t-foreach="this.state.pendingImages" t-as="pimg" t-key="pimg_index">
                                <div class="o_chatboo_pending_image d-inline-flex align-items-center gap-1 p-1 border rounded bg-light">
                                    <img t-att-src="pimg" alt="pasted image"
                                         style="height:40px;width:auto;border-radius:4px;"/>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1"
                                            t-att-aria-label="this.tipRemoveImage" t-on-click="() => this._removePendingImage(pimg_index)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </t>
                        </div>
                        <div t-if="this.state.pendingFiles.length" class="d-flex flex-wrap gap-1 mb-1">
                            <t t-foreach="this.state.pendingFiles" t-as="pfile" t-key="pfile_index">
                                <div class="o_chatboo_pending_file d-inline-flex align-items-center gap-1 px-2 py-1 border rounded"
                                     style="font-size:0.8em;max-width:220px;background:#f1f3f5;color:#212529;border-color:#ced4da !important;">
                                    <i t-att-class="'fa ' + this._fileIcon(pfile)" style="color:#495057;"/>
                                    <span class="text-truncate" t-out="pfile.name"/>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1"
                                            t-att-aria-label="this.tipRemoveFile" t-on-click="() => this._removePendingFile(pfile_index)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </t>
                        </div>
                        <input type="file" t-ref="this.fileInputRef" class="d-none" multiple="multiple"
                               accept=".txt,.md,.csv,.tsv,.log,.json,.xlsx,.xlsm,.xls,.docx,.doc,.pdf,.png,.jpg,.jpeg,.gif,.bmp,.webp,.svg,.ico,image/*,application/pdf,text/csv,application/json,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel.sheet.macroEnabled.12,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                               t-on-change="this.onFilesSelected"/>
                        <div t-attf-class="o_chatboo_prompt_wrap {{ this.state.promptMultiline ? 'o_chatboo_prompt_has_toggle' : '' }}"
                             t-att-style="'--o-chatboo-prompt-max-lines:' + this.promptMaxLines">
                            <textarea class="form-control o_chatboo_prompt" t-ref="this.inputRef" rows="1"
                                   t-att-placeholder="this.state.inputPlaceholder"
                                   t-on-input="this.onInput"
                                   t-on-keydown="this.onKeydown"
                                   t-on-paste="this.onPaste"
                                   t-att-disabled="this.state.thinking"/>
                            <button t-if="this.state.promptMultiline"
                                    type="button"
                                    class="btn btn-light border o_chatboo_prompt_resize"
                                    t-att-aria-label="this.tipPromptResize"
                                    t-on-click="() => this._togglePromptCollapsed()">
                                <i t-attf-class="fa {{ this.state.promptCollapsed ? 'fa-chevron-down' : 'fa-chevron-up' }}"/>
                            </button>
                        </div>
                    </div>
                    <button class="btn btn-light border o_chatboo_composer_btn" t-on-click="() => this.onClipClick()"
                            t-att-aria-label="this.tipAttach" t-att-disabled="this.state.thinking">
                        <i class="fa fa-paperclip"/>
                    </button>
                    <button class="btn btn-primary o_chatboo_composer_btn" t-on-click="() => this._sendMessage()"
                            t-att-aria-label="this.tipSend"
                            t-att-disabled="this.state.thinking || (!this.state.promptNonempty &amp;&amp; !this.state.pendingImages.length &amp;&amp; !this.state.pendingFiles.length)">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </div>

            <!-- Modal historial (O14) -->
            <t t-if="this.state.showSessionModal">
                <div class="o_chatboo_session_modal_backdrop" t-on-click.self="() => this._closeSessionsModal()">
                    <div class="o_chatboo_session_modal" t-on-click.stop="">
                        <div class="modal-header align-items-center border-bottom px-3 py-2">
                            <h5 class="modal-title m-0">Session History</h5>
                            <t t-if="this.state.sessions.length">
                                <div class="ms-3 me-auto d-flex align-items-center gap-3 border-start ps-3">
                                    <div class="form-check mb-0">
                                        <input type="checkbox" class="form-check-input" id="checkAllSessions"
                                               t-att-checked="this.state.selectedSessions.length === this.state.sessions.length"
                                               t-on-change="this._toggleAllSessions"/>
                                        <label class="form-check-label" for="checkAllSessions">Select all</label>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger"
                                            t-att-disabled="!this.state.selectedSessions.length"
                                            t-on-click="() => this._bulkDeleteSessions()">
                                        <i class="fa fa-trash me-1"/> Delete (<t t-out="this.state.selectedSessions.length"/>)
                                    </button>
                                </div>
                            </t>
                            <button type="button" class="btn-close ms-2" t-on-click="() => this._closeSessionsModal()"/>
                        </div>
                        <div class="modal-body overflow-auto p-0">
                            <div class="list-group list-group-flush">
                                <t t-foreach="this.state.sessions" t-as="session" t-key="session.id">
                                    <div class="list-group-item d-flex align-items-center"
                                         style="cursor:pointer;" t-on-click="() => this._selectSession(session.id)">
                                        <div class="me-3" t-on-click.stop="">
                                            <input type="checkbox" class="form-check-input"
                                                   t-att-checked="this.state.selectedSessions.includes(session.id)"
                                                   t-on-change="() => this._toggleSessionSelection(session.id)"/>
                                        </div>
                                        <t t-if="this.state.editingSessionId === session.id">
                                            <div class="d-flex flex-grow-1 gap-2" t-on-click.stop="">
                                                <input type="text" class="form-control form-control-sm"
                                                       t-att-value="this.state.editingSessionName"
                                                       t-on-input="(ev) => this.state.editingSessionName = ev.target.value"
                                                       t-on-keydown="this._onRenameInputKeydown"/>
                                                <button class="btn btn-sm btn-success" t-on-click.stop="() => this._saveRenameSession()">
                                                    <i class="fa fa-check"/>
                                                </button>
                                                <button class="btn btn-sm btn-secondary" t-on-click.stop="() => this._cancelRenameSession()">
                                                    <i class="fa fa-times"/>
                                                </button>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center">
                                                    <strong t-out="session.name"/>
                                                    <span t-if="this.state.currentSessionId === session.id" class="badge bg-primary text-white ms-2">Current</span>
                                                </div>
                                                <small class="text-muted">
                                                    <t t-out="session.message_count || 0"/> messages
                                                    <t t-if="session.formatted_date"> · <t t-out="session.formatted_date"/></t>
                                                </small>
                                            </div>
                                            <div class="btn-group" t-on-click.stop="">
                                                <button class="btn btn-sm btn-link" t-on-click="() => this._startRenameSession(session.id, session.name)">
                                                    <i class="fa fa-edit"/>
                                                </button>
                                                <button class="btn btn-sm btn-link text-danger" t-on-click="() => this._deleteSession(session.id)">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="!this.state.sessions.length">
                                    <div class="list-group-item text-muted text-center">
                                        <small>No saved sessions yet.</small>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="modal-footer border-top px-3 py-2">
                            <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this._closeSessionsModal()">Close</button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
